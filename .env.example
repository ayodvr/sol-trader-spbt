PRIVATE_KEY=<your_base58_private_key>
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# ─── Yellowstone gRPC (Alchemy Richat — recommended, ~$0.30/month) ───
# 1. Sign up free at: https://www.alchemy.com
# 2. Create a new App → Network: Solana Mainnet
# 3. Copy your API Key and paste it as GRPC_TOKEN below
# Endpoint is the same for all accounts — only the key changes
GRPC_ENDPOINT=https://solana-mainnet.g.alchemy.com
GRPC_TOKEN=your_alchemy_api_key_here
# Set to true ONLY if using a Triton NaaE endpoint (most users: leave false)
GRPC_USE_TRITON_V5=false

# ─── Jito Settings ───
JITO_BLOCK_ENGINE=https://mainnet.block-engine.jito.wtf
# Legacy static tip (used if dynamic tipping is disabled)
JITO_TIP_SOL=0.005

# Dynamic Tipping
DYNAMIC_TIPPING_ENABLED=true
JITO_MIN_TIP_SOL=0.001
JITO_MAX_TIP_SOL=0.05

# ─── Trading Parameters ───
SNIPE_AMOUNT_SOL=0.1
MAX_BUY_TAX=15
MAX_SELL_TAX=15

# ─── Exit Strategy ───
EXIT_PROFIT_PERCENT=300
EXIT_DRAWDOWN_PERCENT=30
# Trailing stop: triggers when price drops X% from its highest point
# 15% is conservative — good for volatile memecoins
TRAILING_STOP_PERCENT=15

# ─── Social & Developer Filtering ───
REQUIRE_SOCIALS=true
MIN_DEV_HISTORY_SCORE=50

# Helius API key — used for developer wallet history check (rug detection)
# Get yours at: https://www.helius.dev (1M requests/month on free tier)
HELIUS_API_KEY=your_helius_api_key_here

# ─── Telegram Notifications (optional) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Dashboard API Security ───
# REQUIRED to use the dashboard — set a strong random string (e.g. openssl rand -hex 32)
API_SECRET_KEY=your_very_strong_secret_key_here

# Dashboard CORS — set this to your Vercel URL when deploying
# Leave as default for local development
DASHBOARD_URL=http://localhost:5173

# ─── Dry Run Mode ───
# Set to true to simulate trades without sending to Jito (safe for testing)
DRY_RUN=true
